# WorldOS — Environment Variables Reference
# Sao chép file này thành .env và điền giá trị phù hợp

# =====================================================================
# Application
# =====================================================================
APP_NAME=worldos
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost

# =====================================================================
# Database (PostgreSQL)
# =====================================================================
DB_HOST=db
DB_DATABASE=worldos
DB_USERNAME=worldos
DB_PASSWORD=secret
DB_PORT_EXPOSE=15432

# =====================================================================
# Redis
# =====================================================================
REDIS_HOST=redis
REDIS_PORT_EXPOSE=16379

# =====================================================================
# Services Ports
# =====================================================================
BACKEND_PORT=18080
FRONTEND_PORT=13000
ADMINER_PORT=18081
SIMULATION_ENGINE_PORT=50051

# =====================================================================
# WorldOS Simulation Engine (Rust gRPC)
# =====================================================================
# Docker: dùng service name trong Docker network (mặc định đã set trong docker-compose)
# Local (non-Docker): dùng 127.0.0.1:50051
SIMULATION_ENGINE_GRPC_HOST=simulation-engine:50051
SIMULATION_ENGINE_TIMEOUT_MS=5000
